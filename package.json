{
  "name": "test-automation-framework",
  "version": "1.0.0",
  "description": "Playwright + Cucumber test automation framework",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf src/reports/cucumber-json src/reports/html-report src/reports/action-logs src/reports/execution-summary src/reports/screenshots playwright-report test-results",
    "test": "cucumber-js --config cucumber.cjs",
    "test:smoke": "cucumber-js --config cucumber.cjs --tags \"@smoke\"",
    "test:headed": "node src/runners/test-runner.js --headed",
    "report": "node src/runners/report-runner.js",
    "inspect": "npx playwright codegen --target=javascript",
    "mcp:server": "npx @playwright/mcp@latest"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "demo-framework",
    "bdd-automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "^1.53.0",
    "docx": "^9.7.1",
    "dotenv": "^17.0.1",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.3.0",
    "playwright": "^1.53.0",
    "rimraf": "^6.0.1"
  },
  "devDependencies": {
    "eslint": "^9.28.0"
  }
}
